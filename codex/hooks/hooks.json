{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/session_start.mjs\" --host codex",
            "timeout": 5,
            "additionalContextLimit": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/sync_memory.mjs\" --host codex",
            "timeout": 10,
            "additionalContextLimit": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/pretool_sync.mjs\" --host codex",
            "timeout": 5,
            "additionalContextLimit": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__penny_(write|edit)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/posture_record.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/session_end.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/send_transcript.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
